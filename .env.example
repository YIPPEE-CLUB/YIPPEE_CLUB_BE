SECRET_KEY=django-insecure-local-development-only-change-me-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=yippee_club_db
MYSQL_USER=yippee_user
MYSQL_PASSWORD=local-dev-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Separate MySQL database used only by Django tests.
MYSQL_TEST_DATABASE=test_yippee_club_db

# SMTP sends real messages. RedactedConsoleBackend is a local simulation only.
# EMAIL_BACKEND=email_verification.mail.RedactedConsoleBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com

# Configurable development defaults, not finalized v1.5 policy.
AUTH_CODE_TTL_SECONDS=180
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_SEND_COOLDOWN_SECONDS=60
AUTH_RATE_WINDOW_SECONDS=600
AUTH_IP_LIMIT=30
AUTH_EMAIL_LIMIT=10

# Configurable defaults; the final v1.5 lifetime policy is not fixed.
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=86400
PASSWORD_RESET_TIMEOUT=600
