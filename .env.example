SECRET_KEY=django-insecure-local-development-only-change-me-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=yippee_club_db
MYSQL_USER=yippee_user
MYSQL_PASSWORD=local-dev-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS deployment settings. Keep these defaults for local HTTP development.
# Enable secure cookies after HTTPS is verified. Redirect at Django or the edge.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Start HSTS only after HTTPS is verified across the intended scope.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Configure SECURE_PROXY_SSL_HEADER only after verifying the proxy trust boundary.

# Separate MySQL database used only by Django tests.
MYSQL_TEST_DATABASE=test_yippee_club_db

# SMTP sends real messages. RedactedConsoleBackend is a local simulation only.
# EMAIL_BACKEND=email_verification.mail.RedactedConsoleBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# Set both EMAIL_HOST_USER and DEFAULT_FROM_EMAIL to your Gmail address.
# EMAIL_HOST_PASSWORD must be a Google app password, never your account password.
DEFAULT_FROM_EMAIL=
# Optional recipient for scripts/check_gmail_smtp.py --send (no automatic send).
SMTP_TEST_RECIPIENT=

# Configurable development defaults, not finalized v1.5 policy.
AUTH_CODE_TTL_SECONDS=180
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_SEND_COOLDOWN_SECONDS=60
AUTH_RATE_WINDOW_SECONDS=600
AUTH_IP_LIMIT=30
AUTH_EMAIL_LIMIT=10

# Configurable defaults; the final v1.5 lifetime policy is not fixed.
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=86400
PASSWORD_RESET_TIMEOUT=600
# Required for reset emails: fixed HTTPS page, no query/fragment or credentials.
# Leave empty until the frontend URL is approved; reset requests fail safely.
PASSWORD_RESET_FRONTEND_URL=

# Keep false until authoritative purchase permissions are connected/imported
# and completeness has been explicitly reviewed. This is not a payment flag.
CART_PURCHASE_ENTITLEMENTS_VERIFIED=False
